{
  "manifest_version": 3,
  "name": "O Espertinho",
  "description": "Geração de links de afiliados por configuração, com autenticação e processamento em lotes.",
  "version": "0.2.0",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://127.0.0.1/*"
  ],
  "icons": {
    "16": "icons/fox-v4-16.png",
    "32": "icons/fox-v4-32.png",
    "48": "icons/fox-v4-48.png",
    "128": "icons/fox-v4-128.png"
  },
  "action": {
    "default_title": "O Espertinho",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/fox-v4-16.png",
      "32": "icons/fox-v4-32.png",
      "48": "icons/fox-v4-48.png",
      "128": "icons/fox-v4-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' https: http://localhost:* http://127.0.0.1:*; base-uri 'none'; frame-ancestors 'none';"
  }
}
