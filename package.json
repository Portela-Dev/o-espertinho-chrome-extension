{
  "name": "o-espertinho-chrome-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Boilerplate da extensão Chrome do O Espertinho.",
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "validate:html": "html-validate extension/popup.html",
    "build": "node scripts/build.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "npm run typecheck && npm run validate:html && npm test"
  },
  "devDependencies": {
    "@types/chrome": "0.3.5",
    "fflate": "0.8.3",
    "html-validate": "11.16.4",
    "typescript": "7.0.2"
  }
}
